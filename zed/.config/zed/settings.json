// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "soft_wrap": "editor_width",
  "vim": {
    "gdefault": true,
    "toggle_relative_line_numbers": false
  },
  "which_key": {
    "enabled": true
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
    "gemini": {
      "type": "registry",
    },
  },
  "diff_view_style": "unified",
  "window_decorations": "server",
  "show_edit_predictions": false,
  "relative_line_numbers": "enabled",
  "notification_panel": {
    "dock": "left",
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-haiku-4-5",
      "enable_thinking": false
    },
    "default_profile": "ask",
    "default_model": {
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "claude-sonnet-4-5",
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "project_panel": {
    "dock": "right",
  },
  "git_panel": {
    "collapse_untracked_diff": true,
    "dock": "right",
    "tree_view": true,
  },
  "edit_predictions": {
    "copilot": {
      "enable_next_edit_suggestions": false,
    },
    "provider": "none",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "terminal": {
    "dock": "bottom",
    "env": {},
    "font_size": 13.0,
    "font_family": "JetBrainsMono Nerd Font Mono",
  },
  "base_keymap": "VSCode",
  "minimap": {
    "show": "never",
  },
  "cursor_blink": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "buffer_font_family": "JetBrainsMono Nerd Font Propo",
  "file_types": {
    "toml": ["*.toml"],
  },
  "linked_edits": true,
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha (Blur) [Heavy]",
  },
  "languages": {
    "LaTeX": {
      "indent_guides": {
        "background_coloring": "indent_aware",
      },
    },
    "Python": {
      "language_servers": [
        // Disable basedpyright and enable ty, and otherwise
        // use the default configuration.
        "ty",
        "!basedpyright",
        "!pylsp",
        "...",
      ],
    },
  },
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "onSave": true,
            "forwardSearchAfter": true,
          },
          "forwardSearch": {
            "executable": "okular",
            "args": ["--unique", "file:%p#src:%l%f"],
          },
        },
      },
    },
  },
}
